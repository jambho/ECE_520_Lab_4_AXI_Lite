# ---------- Vivado generated output ----------
*.cache/
*.gen/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
.Xil/
*.jou
*.log
*.str
*.backup.*
webtalk*
vivado_pid*
hs_err_pid*

# Synthesis/implementation checkpoints and bitstreams (regenerated by Vivado)
*.dcp
*.bit
*.ltx
# Hardware exports are kept so the Vitis apps can be rebuilt without rerunning Vivado
!*.xsa

# Block design generated artifacts (the .bd and .xci files are kept)
*.bda
**/bd/*/ui/

# ---------- Vitis (classic) workspace output ----------
.metadata/
.analytics
RemoteSystemsTempFiles/
IDE.log
Debug/
Release/
_ide/
# Platform build output (the platform.spr and .xsa are kept)
**/mult_soc_vitis/*/export/
**/mult_soc_vitis/*/hw/
**/mult_soc_vitis/*/logs/
**/mult_soc_vitis/*/resources/
**/mult_soc_vitis/*/ps7_cortexa9_0/
**/mult_soc_vitis/*/zynq_fsbl/

# ---------- OS / editor ----------
Thumbs.db
desktop.ini
.DS_Store
*.swp
*~
